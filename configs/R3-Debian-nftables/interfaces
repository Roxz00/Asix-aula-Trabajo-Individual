# /etc/network/interfaces · R3-Debian-nftables
auto lo
iface lo inet loopback

# WAN · Adaptador 1 · NAT de VirtualBox
auto enp0s3
iface enp0s3 inet static
    address 10.0.2.15/24
    gateway 10.0.2.2

# LAN · Adaptador 2 · Red interna LAN_G3
auto enp0s8
iface enp0s8 inet static
    address 192.168.30.3/24
